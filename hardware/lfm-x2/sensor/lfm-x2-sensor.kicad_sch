	(rectangle (start 12.7 12.7) (end 292.1 233.68) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "4532c9d0-9441-417d-af2b-c649c865d073"))
	(text "PAPAN SENSOR: 12x LED IR + FOTOTRANSISTOR PT67-21B, CD74HC4067M" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "bcddce3d-571a-4dc7-be2e-76594e6fd37a"))
	(text "LED IR selalu nyala: 220 ohm dari +5V (+-17 mA; LED Everlight IR67-21C: VF 1,3 V, maks 65 mA).\nPT67-21B lensa hitam (700-1100 nm, puncak 940 nm): kolektor ditarik 10k ke +3V3 = Sn, makin terang makin rendah.\n10k titik awal: cek di breadboard di atas banner (4,7k-22k)." (exclude_from_sim no) (at 15.24 124.46 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d964d93c-ddda-4bcc-9d7e-4f079a61d4d7"))
	(text "Pad 1 = katoda LED / emitor PT, pad 2 = anoda / kolektor. Sudut terpotong Everlight di sisi pad 2;\nLED IR lain bisa terbalik: cek dengan multimeter mode dioda sebelum disolder." (exclude_from_sim no) (at 15.24 139.7 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "741ebf56-2068-4ba5-bcb6-d68ef5aa3b99"))
	(text "S1..S12 = I2..I13 (sama dengan rev B). I0, I1, I14, I15 kosong.\nKanal 1 = paling kiri dilihat dari atas, robot menghadap depan.\nJ1 FFC 1,0 mm 8 pin, urutan = J1 PCB sensor rev B. Kabel FFC tipe B (kontak berlawanan)." (exclude_from_sim no) (at 127 210.82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "8116eac2-0756-42a9-90c0-a9846337dc92"))

	(rectangle (start 12.7 12.7) (end 292.1 233.68) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "928a2239-f5dc-4e27-8ab7-aa3a504f62d2"))
	(text "PAPAN SENSOR: 12x QRE1113GR, CD74HC4067M" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "0b4ef80e-9aae-4eb8-b6b2-c50169cb8c78"))
	(text "QRE1113GR: LED IR selalu nyala, 220 ohm dari +5V (+-17 mA, sama dengan jalur utama).\nFototransistor: kolektor ditarik 10k ke +3V3 = Sn, makin terang pantulan makin rendah.\n10k titik awal: cek di breadboard di atas banner (4,7k-22k)." (exclude_from_sim no) (at 15.24 124.46 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "939594c7-4a49-468f-be78-c920f5a8c057"))
	(text "Pin QRE1113GR: 1 anoda, 2 katoda, 3 kolektor, 4 emitor (OnSemi CASE 100CY).\nDipasang di sisi bawah, LED di depan, fototransistor di belakang." (exclude_from_sim no) (at 15.24 139.7 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ddc0360f-6cb5-476b-a0bb-2649bd96f685"))
	(text "S1..S12 = I2..I13 (sama dengan rev B). I0, I1, I14, I15 kosong.\nKanal 1 = paling kiri dilihat dari atas, robot menghadap depan.\nJ1 JST XH 8 pin tegak, urutan = J1 PCB sensor rev B, kabel lurus ke J3 papan utama." (exclude_from_sim no) (at 127 210.82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "55ce6a21-eac1-4fa4-8254-81496656a4a4"))

	(rectangle (start 12.7 12.7) (end 292.1 152.4) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "c9048db7-7a69-4eb9-ae48-a509fa5cc9ec"))
	(text "1. DAYA" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "8f7553af-cd00-46d5-8790-a5cd8ff1b290"))
	(text "J1: pack Li-ion 2S (6,0-8,4 V). Pin 1 = BAT+, tanpa proteksi polaritas terbalik." (exclude_from_sim no) (at 15.24 22.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "4d871058-e627-45fa-a98e-094f87a697be"))
	(text "Q1 + SW1: saklar daya. SW1 ke GND = hidup (Vgs = -0,91 x VBAT).\nSW1 hanya dialiri arus gate, arus motor lewat Q1 (maks kontinu +-2 A)." (exclude_from_sim no) (at 60.96 60.96 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7e2f7c86-df5f-48da-be99-35fb4c2911e4"))
	(text "VBAT_SENSE ke GPIO39:\nVBAT x 33/133 (8,4 V -> 2,08 V)" (exclude_from_sim no) (at 236.22 64.77 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b060c519-1696-4e7f-a5c4-492bea9defe9"))
	(text "U4 buck 5,3 V: R6/R7 = 0,8 V x (1 + 220k/39k). R5 100k -> +-900 kHz. EN dibiarkan lepas = aktif.\nNilai lain dari datasheet MP1584 gambar 4 (5 V): L 15 uH, C3 150 pF, R3 100k." (exclude_from_sim no) (at 15.24 116.84 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "765ab055-893d-4b67-ac68-a312a946dde4"))
	(text "D2/D3: +5V dari buck atau USB (yang lebih tinggi). 5,3 V - 0,35 V = +-5,0 V." (exclude_from_sim no) (at 15.24 147.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0b6b89e4-525b-4429-9c60-fbf6ece4f78b"))
	(text "PWR_FLAG: VBAT, +5V, GND" (exclude_from_sim no) (at 228.6 121.92 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "acbcca7b-7799-4a9c-a993-54c4e22e10b5"))
	(rectangle (start 12.7 157.48) (end 292.1 297.18) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "a296ff4a-72cf-4ef2-a33b-4563af7329ec"))
	(text "2. ESP32-WROOM-32E + USB (CH340C, auto-reset)" (exclude_from_sim no) (at 15.24 162.56 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "f37b5683-df2a-4067-a794-ecfe11dbc551"))
	(text "J4: R10/R11 5,1k di CC = perangkat USB (dapat 5 V dari laptop/charger).\nU2 dicatu 3,3 V: V3 disambung ke VCC (datasheet CH340)." (exclude_from_sim no) (at 15.24 284.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0109bd60-d493-4cb3-85f8-9184a0c7c117"))
	(text "Q2/Q3: auto-reset saat upload\n(DTR, RTS -> EN, IO0)" (exclude_from_sim no) (at 132.08 255.27 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0a5eff92-2b66-4a88-a64a-d1ea43017191"))
	(text "IO2 (DRV_EN) dan IO12 (BUZ) ditarik ke GND:\nsyarat boot ESP32. IO5, IO15, IO27 kosong." (exclude_from_sim no) (at 132.08 274.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "800a77b4-90b4-4466-8343-5ff707dbc19b"))
	(text "C14/C15 dekat pin 3V3 U1" (exclude_from_sim no) (at 246.38 289.56 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "15de4223-1632-49a3-ad25-8dcb656bda57"))
	(rectangle (start 297.18 12.7) (end 581.66 160.02) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "9ffde2d9-3956-4d2d-8b3c-c0fa00bb7a10"))
	(text "3. DRIVER MOTOR: 4x BTN7971B (setengah H-bridge, 2 per motor)" (exclude_from_sim no) (at 299.72 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "17471cc2-c9dc-4008-b3ad-32aa9d29dabe"))
	(text "Maju: IN1 = PWM, IN2 = 0. Mundur: IN1 = 0, IN2 = PWM. Rem: IN1 = IN2.\nDRV_EN (GPIO2) = INH keempat chip: LOW = tidur, keluaran lepas." (exclude_from_sim no) (at 406.4 127 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "999ef09d-8889-4567-9f4f-4a10f94b250e"))
	(text "J2/J3 = urutan pin jalur utama:\n1 M+, 2 3V3, 3 ENC A, 4 ENC B, 5 GND, 6 M-" (exclude_from_sim no) (at 502.92 142.24 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d98662a5-b5f9-4fe8-9df7-1f7368863c48"))
	(rectangle (start 297.18 165.1) (end 581.66 358.14) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "ab23a663-3bbb-4c1a-81a2-64d31e8113d0"))
	(text "4. SENSOR GARIS: 12x QRE1113GR + CD74HC4067M" (exclude_from_sim no) (at 299.72 170.18 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "2c8c83df-615e-4e12-8dad-d203b224fd77"))
	(text "Sama dengan PCB sensor rev B: LED IR selalu nyala (220 ohm dari +5V, +-17 mA),\nkolektor ditarik 10k ke +3V3, S1..S12 = I2..I13. I0, I1, I14, I15 kosong.\nIR1 = paling kiri, IR12 = paling kanan (dilihat dari atas, robot menghadap depan)." (exclude_from_sim no) (at 411.48 304.8 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6786d16a-ea0b-40a0-bbbb-a295dfada11b"))
	(rectangle (start 12.7 302.26) (end 292.1 406.4) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "3f5916eb-0e8b-4486-abfc-e10715e05c1a"))
	(text "5. ANTARMUKA: OLED, 6 TOMBOL, BUZZER" (exclude_from_sim no) (at 15.24 307.34 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "24aeb2b9-8ddf-4659-b518-3676ce496bbb"))
	(text "J5: cek urutan pin modul OLED (GND VCC SCL SDA)." (exclude_from_sim no) (at 15.24 396.24 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "70d3ed66-9e69-44d4-9aea-c952dc42aee6"))
	(text "Tangga resistor di GPIO34 (pull-up 10k): ATAS 0,30 V, BAWAH 0,93 V, KEMBALI 1,49 V, OK 2,12 V, LANJUT 2,63 V, lepas 3,3 V" (exclude_from_sim no) (at 60.96 311.15 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "77920e33-ed3a-4150-b03f-0041760b6223"))
	(text "START: tombol ke-6, sendiri di GPIO35" (exclude_from_sim no) (at 60.96 365.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "db16d2d1-acb1-4897-80aa-b8635171b5cc"))
	(text "R pull-down menjaga GPIO12\nLOW saat boot" (exclude_from_sim no) (at 238.76 388.62 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f99ff0f1-357d-4a1d-9e03-2fb761b843f5"))
	(rectangle (start 297.18 363.22) (end 398.78 406.4) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "24cacd03-7469-446c-af0b-6474d0277ddf"))
	(text "PIN ESP32 (beda dari jalur utama: motor)" (exclude_from_sim no) (at 299.72 368.3 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "8f946265-8bbe-4baa-a46f-3b9d655773bb"))
	(text "ML_IN1 18, ML_IN2 17, MR_IN1 16, MR_IN2 4, DRV_EN 2\nMUX_SIG 36, S0-S3 26/25/33/32, VBAT_SENSE 39\nBTN 34, BTN2 35, BUZ 12, SDA 21, SCL 22\nENC_L A/B 13/14, ENC_R A/B 23/19" (exclude_from_sim no) (at 299.72 388.62 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7568f9fa-3706-45af-82fc-9a7c8571c443"))

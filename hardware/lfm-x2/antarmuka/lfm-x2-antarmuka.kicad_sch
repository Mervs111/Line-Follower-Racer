	(rectangle (start 12.7 12.7) (end 292.1 167.64) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "849efb27-5b96-4fa5-af43-c4ca378273f2"))
	(text "PAPAN ANTARMUKA: OLED, 6 TOMBOL MENU, RST, BUZZER" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "2b1ebbd1-a0f2-4b16-8fe0-cfa11f39f2d6"))
	(text "J2: cek urutan pin modul\nOLED (GND VCC SCL SDA)." (exclude_from_sim no) (at 15.24 55.88 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5e87b486-248f-4df8-8a0c-2904e59ffb30"))
	(text "Tangga resistor di GPIO34 (pull-up 10k): ATAS 0,30 V, BAWAH 0,93 V, KEMBALI 1,49 V, OK 2,12 V, LANJUT 2,63 V, lepas 3,3 V" (exclude_from_sim no) (at 60.96 21.59 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "628543b0-9a91-4797-a52a-f0fc90cd2d0d"))
	(text "START: tombol ke-6, sendiri di GPIO35" (exclude_from_sim no) (at 60.96 76.2 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "8ac82168-2fb1-4847-9e7e-1548b0d15932"))
	(text "RST: menarik EN ke GND\n(R/C EN di papan utama)" (exclude_from_sim no) (at 17.78 104.14 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "966d2ea2-87ba-4910-bb41-11848f1fa592"))
	(text "Q1 + buzzer aktif 5 V (BUZ = GPIO17).\nR 10k basis menahan buzzer mati saat boot." (exclude_from_sim no) (at 198.12 109.22 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "bf1506eb-b69d-407f-a6a7-4ac6f914e222"))
	(text "J1: header 2x5 di sisi bawah, masuk ke socket J4 papan utama (ditumpuk, jarak antar-papan +-11 mm).\nTombol tinggi 7-8 mm atau diberi tutup supaya tidak tenggelam di bawah OLED." (exclude_from_sim no) (at 76.2 137.16 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e1a96d21-e83d-4b25-b9b2-509f7f9269e9"))

	(rectangle (start 12.7 12.7) (end 292.1 210.82) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "2cc406c9-a4e8-4bae-a470-c2084fe5db12"))
	(text "PAPAN DRIVER MOTOR: 4x BTN7971B (setengah H-bridge, 2 per motor)" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "3fb29fa8-bd0e-4f6e-bddb-dab5d01ed70b"))
	(text "Maju: IN1 = PWM, IN2 = 0. Mundur: IN1 = 0, IN2 = PWM. Rem: IN1 = IN2.\nDRV_EN (GPIO2) = INH keempat chip: LOW = tidur, keluaran lepas (pull-down di papan utama)." (exclude_from_sim no) (at 121.92 127 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0fe3b052-5d97-4297-b45b-092e0ec71698"))
	(text "J2/J3 = urutan pin jalur utama: 1 M+, 2 3V3, 3 ENC A, 4 ENC B, 5 GND, 6 M-" (exclude_from_sim no) (at 124.46 152.4 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "421bc30f-fc0c-4ba5-bfa4-f9a90f661f7c"))
	(text "J1: header 2x7 di sisi atas, masuk ke socket J5 di sisi bawah papan utama.\nC 100 uF dekat J1 (VBAT dari papan utama lewat 2 pin)." (exclude_from_sim no) (at 76.2 200.66 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "65f5b321-7f73-41b8-b6dd-4ffbe3d9090e"))

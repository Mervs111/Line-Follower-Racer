	(rectangle (start 12.7 12.7) (end 292.1 152.4) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "5dfc2d8d-dab7-4020-901e-9a4d9f7e193a"))
	(text "1. DAYA" (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "079c36e7-c76f-42f3-8e51-6202da843aba"))
	(text "J1: LiPo 2S (6,0-8,4 V) lewat XT30PW-M (pack XT30 betina). Pin 1 = GND (sudut miring),\npin 2 = BAT+ (sisi rata). Tanpa proteksi polaritas terbalik: cek tanda + pada pack." (exclude_from_sim no) (at 15.24 22.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1cf0d8b2-9490-4c08-a9ae-ec778f255295"))
	(text "Q1 + SW1: saklar daya. SW1 ke GND = hidup (Vgs = -0,91 x VBAT).\nSW1 hanya dialiri arus gate, arus motor lewat Q1 (maks kontinu +-2 A)." (exclude_from_sim no) (at 60.96 60.96 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "665d5812-5dfc-4de3-b5cc-c3898127a25b"))
	(text "VBAT_SENSE ke GPIO39:\nVBAT x 33/133 (8,4 V -> 2,08 V)" (exclude_from_sim no) (at 236.22 64.77 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "677d3adb-826d-4618-b445-42849085170b"))
	(text "U4 buck 5,3 V: umpan balik 0,8 V x (1 + 220k/39k). R 100k di FREQ -> +-900 kHz. EN dibiarkan lepas = aktif.\nNilai lain dari datasheet MP1584 gambar 4 (5 V): L 15 uH, C 150 pF + R 100k kompensasi." (exclude_from_sim no) (at 15.24 116.84 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "37d219e6-1785-4ac9-aab2-c9fc9aca0477"))
	(text "D2/D3: +5V dari buck atau USB (yang lebih tinggi). 5,3 V - 0,35 V = +-5,0 V." (exclude_from_sim no) (at 15.24 147.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "73113ab0-6c3f-4aef-80e1-fcbdadeda68e"))
	(text "PWR_FLAG: VBAT, +5V, GND" (exclude_from_sim no) (at 228.6 121.92 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f7166967-8c78-413e-b7f5-a4e5f3ebdc52"))
	(rectangle (start 12.7 157.48) (end 292.1 297.18) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "e556fbb2-44fa-4ba8-8600-c9c98966d688"))
	(text "2. ESP32-WROOM-32E + USB (CH340C, auto-reset)" (exclude_from_sim no) (at 15.24 162.56 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "138eff7a-4eb1-4698-9196-f83ba0367cd8"))
	(text "J2: R 5,1k di CC = perangkat USB (dapat 5 V dari laptop/charger).\nU2 dicatu 3,3 V: V3 disambung ke VCC (datasheet CH340)." (exclude_from_sim no) (at 15.24 284.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7ac2dd01-d20c-47bf-a98f-17ac4dddcb50"))
	(text "Q2/Q3: auto-reset saat upload\n(DTR, RTS -> EN, IO0)" (exclude_from_sim no) (at 132.08 255.27 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "a4b8ba42-a96c-4fa3-932d-47d614dfb8e4"))
	(text "Tombol RST ada di papan antarmuka (EN lewat J4).\nIO5, IO15, IO27 kosong." (exclude_from_sim no) (at 132.08 274.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "453e2e02-4850-4fda-a02e-0363af461865"))
	(text "C 10 uF/100 nF dekat pin 3V3 U1" (exclude_from_sim no) (at 246.38 289.56 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "cf84d08d-b711-4428-953c-e6bb465f1228"))
	(rectangle (start 297.18 12.7) (end 581.66 160.02) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "9f6046d6-f696-4df1-85be-f2c971d591f1"))
	(text "3. KONEKTOR KE PAPAN LAIN" (exclude_from_sim no) (at 299.72 17.78 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "5c343a7a-928b-4017-8bde-a8c704df9130"))
	(text "J3: FFC 1,0 mm 8 pin ke papan sensor, urutan sama dengan J1 PCB sensor rev B.\nPasang di sisi bawah, di ujung segitiga. MP (kaki pemasang) ke GND." (exclude_from_sim no) (at 299.72 78.74 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "143d77da-9e1c-473e-9502-0373301eed39"))
	(text "J4: socket 2x5 di sisi atas, papan antarmuka ditumpuk di atasnya\n(header 2x5 di sisi bawah papan antarmuka)." (exclude_from_sim no) (at 406.4 78.74 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "70c3d739-358b-4c14-b4fc-e93a436e02d3"))
	(text "J5: socket 2x7 di sisi bawah, papan driver di bawahnya (header 2x7 di sisi atasnya).\nVBAT 2 pin + GND 2 pin (arus motor). R pull-down: IO2 (DRV_EN) dan IO12 (BUZ) LOW saat boot." (exclude_from_sim no) (at 299.72 142.24 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5c4e6fb5-b62c-4daf-853b-2cb4d789b2b0"))
	(rectangle (start 297.18 165.1) (end 398.78 208.28) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "da19a167-5180-4ecb-b643-89822b2fcb22"))
	(text "PIN ESP32 (beda dari jalur utama: motor)" (exclude_from_sim no) (at 299.72 170.18 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left)) (uuid "ebd01f92-0f6b-4a06-97c3-7fba49680dfc"))
	(text "ML_IN1 4, ML_IN2 16, MR_IN1 17, MR_IN2 18, DRV_EN 2\nMUX_SIG 36, S0-S3 26/25/33/32, VBAT_SENSE 39\nBTN 34, BTN2 35, BUZ 12, SDA 21, SCL 22\nENC_L A/B 13/14, ENC_R A/B 23/19" (exclude_from_sim no) (at 299.72 190.5 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "c36e2cd7-199c-463c-aa17-c26b43234c7f"))
